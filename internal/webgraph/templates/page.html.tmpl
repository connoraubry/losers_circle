<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>losers circle - {{.CurrentLabel}}</title>
<link rel="stylesheet" href="style.css">
<script src="https://unpkg.com/cytoscape@3.28.1/dist/cytoscape.min.js"></script>
</head>
<body>
  <header>
    <h1>losers circle</h1>
    <select id="league"></select>
    <select id="conference"></select>
    <select id="year"></select>
    <label><input type="checkbox" id="trim"> hide non-cycle edges between cycle teams</label>
    <span id="status"></span>
    <span id="generated">generated {{.GeneratedAt}}</span>
  </header>
  <div id="cy"></div>
  <div id="legend"></div>
  <script>
    window.CURRENT_KEY = {{.Key}};
    window.DATASETS = {{.Datasets}};
    window.GRAPH = {{.Graph}};
  </script>
  <script src="app.js"></script>
</body>
</html>
